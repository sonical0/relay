# ─── Personal data — cloud sync only, never Git ──────────────────────────────

# PROJECTS: everything but the template
PROJECTS/*/
!PROJECTS/_template/

# SKILLS: the manifest, the README and the template are in Git.
# Real skills are personal — cloud sync only.
SKILLS/**/SKILL.md
!SKILLS/_template/SKILL.md

# The active brain (machines, paths, project intent)
relay-brain.yml

# RELAY_LOG working copy. The stub stays in Git so a first run does not hit a
# missing file. Uncomment to keep the log out of Git entirely:
# RELAY_LOG.md
LOG/

# ─── Generated — rebuilt by npm run bootstrap, never committed ────────────────
relay-projects.derived.yml
.relay-state.md
.relay-state/
.relay-rag.json
.claude/skills/
*.tmp
*.old

# ─── Local environment ───────────────────────────────────────────────────────
.env
.env.local
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ─── Credentials ─────────────────────────────────────────────────────────────
*.secret.*
.credentials.json

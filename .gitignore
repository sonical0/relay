# ─── Personal data — cloud sync only, never Git ──────────────────────────────

# PROJECTS: everything but the template
PROJECTS/*/
!PROJECTS/_template/

# SKILLS: the manifest, the README, the template and the skills Relay ships are in Git.
# Your own skills are personal — cloud sync only.
SKILLS/**/SKILL.md
!SKILLS/_template/SKILL.md
!SKILLS/inbox/SKILL.md
!SKILLS/supervision/SKILL.md

# The active brain (machines, paths, project intent), its chunks and its history
relay-brain.yml
BRAIN/
relay-brain-history.yml

# Journal: one source file per machine (LOG/<host>.md); RELAY_LOG.md is generated
LOG/
RELAY_LOG.md

# Proposals awaiting review (the README stays)
INBOX/*/

# ─── Generated — rebuilt locally, never committed (and never synced) ─────────
relay-projects.derived.yml
.relay-state.md
.relay-state/
.relay-rag.json
.relay-supervision/
.relay-reprise/
.claude/skills/
.claude/rules/
TOOLS/supervision/run/
BACKUPS/
*.tmp
*.old
*.bak-*

# ─── Local environment ───────────────────────────────────────────────────────
.env
.env.local
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ─── Credentials ─────────────────────────────────────────────────────────────
*.secret.*
.credentials.json
